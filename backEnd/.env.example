# 应用配置
DEBUG=True

# 数据库配置
# SQLite (默认，开发环境)
DATABASE_URL=sqlite:///./data/db.sqlite
# MySQL (生产环境)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_fitting_room

# 文件存储
UPLOAD_DIR=./uploads
RESULT_DIR=./results
STATIC_DIR=./static

# 自动清理配置
CLEANUP_ENABLED=True
CLEANUP_INTERVAL_MINUTES=60
UPLOAD_FILE_TTL_HOURS=24
RESULT_FILE_TTL_HOURS=72

# 限流配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50

# AI 服务配置
AI_PROVIDER=mock
# AI_PROVIDER=bailian
# AI_PROVIDER=stable_diffusion

# 阿里百炼配置
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_MODEL=qwen-image-2.0-pro
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Stable Diffusion 配置
STABLE_DIFFUSION_API_URL=http://localhost:7860

# 公网访问地址（用于生成图片访问链接）
PUBLIC_BASE_URL=http://localhost:8000

# JWT 配置
JWT_SECRET_KEY=your-super-secret-key-change-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 默认配额
DEFAULT_QUOTA=10

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=False

# 邮箱验证开关（开发环境建议关闭）
REQUIRE_EMAIL_VERIFICATION=False

# 邮件配置（可选，用于发送验证邮件和重置密码邮件）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your-qq@qq.com
# SMTP_PASSWORD=your-authorization-code
# FROM_EMAIL=your-qq@qq.com

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
