# 应用配置
APP_NAME=AI_TryOn_Backend
DEBUG=true

# 数据库配置
DATABASE_URL=sqlite:///./data/db.sqlite

# 上传配置
UPLOAD_DIR=./uploads
RESULT_DIR=./results
STATIC_DIR=./static
MAX_UPLOAD_SIZE=10485760

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50

# AI 服务配置：mock / stable_diffusion / bailian
AI_PROVIDER=mock

# 阿里百炼 Qwen-Image-2.0-Pro（推荐）
# 使用时设置 AI_PROVIDER=bailian，并前往 https://bailian.console.aliyun.com/ 获取 API Key
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_MODEL=qwen-image-2.0-pro
# 北京地域：https://dashscope.aliyuncs.com/api/v1
# 新加坡地域：https://dashscope-intl.aliyuncs.com/api/v1
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Stable Diffusion 配置（可选）
STABLE_DIFFUSION_API_URL=http://localhost:7860

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
